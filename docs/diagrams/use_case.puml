@startuml use_case
!include diagram-style.puml
left to right direction
title OIPPP — actors and use cases
caption Intended release-1.0 behavior from submitted SRS; not an implementation checklist.
actor Student
actor Recruiter
actor "Placement Admin" as Admin
rectangle "OIPPP" {
  package "Shared access" {
    usecase "Sign in" as Login
    usecase "Register Student / Recruiter" as Register
  }
  package "Student experience" {
    usecase "Manage profile / resume" as Profile
    usecase "Search / filter / bookmark listings" as Search
    usecase "Apply / track applications" as Apply
    usecase "Start / resume / submit aptitude test" as Attempt
    usecase "Persist selected answers" as Save
    usecase "Evaluate and show result" as Result
    usecase "View own progress / weak topics" as Progress
  }
  package "Recruiter experience" {
    usecase "Post / edit / close own listings" as Listing
    usecase "Review own listing's applicants" as Review
    usecase "Update application status" as Status
    usecase "Notify student" as Notify
  }
  package "Placement administration" {
    usecase "Approve recruiters / disable accounts" as Accounts
    usecase "Author questions / tests" as Author
    usecase "View placement statistics" as Stats
    usecase "Export placement report CSV" as CSV
  }
}
Student --> Register
Recruiter --> Register
Student --> Login
Recruiter --> Login
Admin --> Login
Student --> Profile
Student --> Search
Student --> Apply
Student --> Attempt
Student --> Progress
Recruiter --> Listing
Recruiter --> Review
Recruiter --> Status
Admin --> Accounts
Admin --> Author
Admin --> Stats
Admin --> CSV
Attempt ..> Save : <<include>>
Attempt ..> Result : <<include>>
Status ..> Notify : <<include>>
legend bottom left
  Admin accounts are seeded, not publicly registered.
  Recruiters cannot author tests or read batch statistics.
endlegend
@enduml
