@startuml seq_apply
actor Student
participant "React Client" as C
participant "Auth Middleware" as MW
participant "ApplicationController" as AC
participant "ApplicationService" as AS
database MongoDB as DB
participant "NotificationService" as NS
Student -> C : click "Apply" (resume, cover note)
C -> MW : POST /api/applications\nAuthorization: Bearer <JWT>
MW -> MW : verify token, role == STUDENT
alt token invalid / wrong role
  MW --> C : 401 / 403
else ok
  MW -> AC : forward request
  AC -> AS : apply(studentId, listingId, payload)
  AS -> DB : find listing by id
  alt listing closed or deadline passed
    AS --> AC : ListingClosedError
    AC --> C : 409 LISTING_CLOSED
  else open
    AS -> DB : insert application\n(unique index studentId+listingId)
    alt duplicate key
      DB --> AS : E11000
      AC --> C : 409 ALREADY_APPLIED
    else inserted
      AS -> DB : append status history (APPLIED)
      AS -> NS : notify(recruiterId, NEW_APPLICATION)
      NS -->> DB : save in-app notification
      AC --> C : 201 {applicationId, status: "APPLIED"}
      C --> Student : show "Application submitted"
    end
  end
end
@enduml
