@startuml component
!include diagram-style.puml
top to bottom direction
title OIPPP — component architecture
caption Release 1.0 as built: one React client, one Express API, MongoDB and an SMTP provider.
rectangle "Browser" as BROWSER {
  component "React SPA (client/)\nVite + React Router + axios + Recharts\nStudent / Recruiter / Admin pages" as UI
}
rectangle "API process — Node.js / Express (server/)" as API {
  component "HTTP middleware\nhelmet / CORS / 100 kB body / rate limits\nJWT + active account + role checks / Joi" as MW
  package "Feature modules — routes → service → model" as MODULES {
    component "users\nauth, lockout, profile, resumes,\nadmin approvals" as AUTH
    component "listings\nCRUD, search, bookmarks,\nrecommendations" as LIST
    component "applications\napply, state machine, review" as APP
    component "notifications\nin-app + email" as NOTIF
    component "audit\nappend-only log" as AUD
    component "settings\none-offer policy" as SET
    component "tests\nquestion bank, tests,\nattempts, scoring" as TEST
    component "analytics\nreadiness view, placement\nstats (5 min cache), CSV" as ANL
  }
  package "In-process jobs" as JOBS {
    component "Attempt timeout sweep\n(every 1 s)" as TIMER
    component "Listing deadline closer\n(every 60 s)" as CLOSER
    component "Email retry\n(1 / 5 / 15 min)" as RETRY
  }
  component "Mongoose models + GridFS bucket" as STORE
}
database "MongoDB replica set\ncollections + GridFS resumes" as DB
cloud "SMTP provider" as SMTP

UI --> MW : HTTPS / REST JSON\nAuthorization: Bearer JWT
MW --> MODULES : authorized, validated request
APP --> NOTIF : status change
APP --> AUD : audit entry
AUTH --> NOTIF : recruiter decision
AUTH --> AUD : admin action
ANL ..> APP : reads
ANL ..> TEST : reads Results
APP ..> SET : reads policy
MODULES --> STORE
JOBS --> STORE
STORE --> DB : API-held credentials
RETRY --> NOTIF
NOTIF --> SMTP : SMTP + STARTTLS
note bottom of TIMER
  The server owns the test clock (ADR-2).
  The sweep catches up after a restart.
end note
note right of ANL
  Aggregations run inside the API (ADR-3).
  No separate Python service.
end note
legend bottom left
  One deployable API (ADR-1). Each module keeps routes, service and model (ADR-4).
  Only the API holds database credentials; the browser holds only its token.
endlegend
@enduml
