@startuml er
!include diagram-style.puml
hide circle
left to right direction
title OIPPP — logical entity relationships
caption Core fields only. MongoDB references are not enforced foreign keys.
entity User {
  *_id : ObjectId
  --
  email <<unique>>
  srn <<unique, students>>
  name, passwordHash, role, status
  failedLogins, lockedUntil
}
entity Profile {
  *userId : User reference <<unique>>
  --
  branch, gradYear, cgpa, skills[0..20]
  resumeFileId : GridFS reference
}
entity "GridFS resume" as Resume {
  *_id : ObjectId
  --
  PDF <= 2 MB
}
entity Settings {
  *key = "global" <<unique>>
  --
  oneOfferPolicy : Boolean
}
entity Listing {
  *_id : ObjectId
  --
  recruiterId : User reference
  company, title, location, mode
  stipend, skills[1..10], minCgpa
  deadline, status : OPEN / CLOSED
}
entity Bookmark {
  *studentId, listingId <<unique pair>>
  --
  createdAt
}
entity Application {
  *_id : ObjectId
  --
  studentId, listingId <<unique pair>>
  resumeFileId, coverNote, status
  rejectReason, history[]
}
entity Notification {
  *_id : ObjectId
  --
  userId : User reference
  applicationId : optional reference
  type, title, message, read
  email : status / attempts / nextAttemptAt
}
entity AuditLog {
  *_id : ObjectId
  --
  actorId : User reference
  entity, entityId : polymorphic target
  action, before, after, at
}
entity Question {
  *_id : ObjectId
  --
  createdBy : User reference
  text, topic, difficulty
  options[2..6], answerIdx <<private>>
  archived, version
}
entity Test {
  *_id : ObjectId
  --
  createdBy : User reference
  title, durationMin : 10..120
  questionIds[5..60] <<distinct>>
  status : DRAFT / PUBLISHED / ARCHIVED
}
entity Attempt {
  *_id : ObjectId
  --
  studentId, testId <<unique pair>>
  startedAt, endsAt <<fixed>>
  questions[] <<embedded snapshot>>
  answers : Map<questionId, optionIdx>
  status, submittedAt, submissionReason
}
entity Result {
  *_id : ObjectId
  --
  attemptId <<unique>>
  studentId, testId <<unique pair>>
  correctAnswers, totalQuestions, score
  topicBreakdown[] <<embedded>>
}
User ||--o| Profile : userId
Profile }o--o| Resume : resumeFileId
User ||--o{ Listing : recruiterId
User ||--o{ Bookmark : studentId
Listing ||--o{ Bookmark : listingId
User ||--o{ Application : studentId
Listing ||--o{ Application : listingId
Application }o--o| Resume : resumeFileId
User ||--o{ Notification : userId
Application |o--o{ Notification : optional applicationId
User ||--o{ AuditLog : actorId
User ||--o{ Attempt : studentId
Test }o--o{ Question : questionIds
Test ||--o{ Attempt : testId
Attempt ||--o| Result : attemptId
legend bottom left
  An application keeps the resume it was sent with (ADR-5).
  Settings is one document of admin switches, such as the one-offer policy (DOM-2).
  Snapshot questions and topic breakdowns are embedded, not separate collections.
  Disabling an account deletes nothing; history stays (SAFE-2).
endlegend
@enduml
