@startuml seq_test_attempt
!include diagram-style.puml
hide footbox
title Aptitude attempt — start, save, recover, finalize
caption As built in server/src/modules/tests (ADR-2).
actor Student
boundary "React test screen" as C
control "aptitude.routes /\naptitude.service" as AS
database "MongoDB" as DB
control "attempt-timeout.job\n(every 1 s)" as TIMER

== Start or resume (TST-3 / SAFE-1) ==
Student -> C : open test
C -> AS : POST /api/tests/{id}/attempts
AS -> AS : authenticate STUDENT; test PUBLISHED
AS -> DB : find by studentId + testId
alt existing closed attempt
  AS --> C : 409 ATTEMPT_EXISTS
else existing IN_PROGRESS attempt
  AS -> AS : finalize first if endsAt has passed
  AS --> C : 200 same attempt + saved answers\n+ endsAt + serverTime
else no attempt
  AS -> DB : create Attempt with question snapshot\nstartedAt = now; endsAt = now + duration
  note right of DB
    Unique (studentId, testId):
    a concurrent duplicate reloads
    the existing attempt.
  end note
  AS --> C : 201 questions (no keys) + endsAt + serverTime
end

== Save each answer (TST-4) ==
loop each selection
  C -> AS : PATCH /api/attempts/{id}/answers\n{questionId, optionIdx}
  alt now >= endsAt
    AS --> C : 409 ATTEMPT_CLOSED
  else open
    AS -> DB : set answers.<questionId> (conditional on IN_PROGRESS)
    AS --> C : 204, client shows Saved
  end
end
opt refresh / reconnect
  C -> AS : GET /api/attempts/{id}
  AS --> C : saved answers + original endsAt
end

== Finalize once (TST-5 / TST-6) ==
alt student submits
  C -> AS : POST /api/attempts/{id}/submit
else deadline passes
  TIMER -> AS : expireOverdue()
end
AS -> AS : score saved answers against snapshot keys
AS -> DB : transaction: close Attempt + insert Result
DB --> AS : committed (or existing Result on retry)
AS --> C : 200 score + topicBreakdown
note over AS, TIMER
  The browser countdown is display only.
  Answers at or after endsAt are refused (D1).
  A closed attempt is never reopened.
end note
@enduml
