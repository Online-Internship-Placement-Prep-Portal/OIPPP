PORT=5000
# Aptitude attempts need transactions: use Atlas or a replica set (see docs/other-docs/aptitude-api.md).
MONGO_URI=mongodb://localhost:27017/oippp?replicaSet=rs0
# Required when NODE_ENV=production.
JWT_SECRET=change-me
JWT_EXPIRES_IN=60m
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when deployed behind one reverse proxy (e.g. Render).
TRUST_PROXY=0

# Leave SMTP_HOST empty to log emails as JSON instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OIPPP <no-reply@oippp.local>

# Used once by `npm run seed` to create the first admin account.
ADMIN_NAME=Placement Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
