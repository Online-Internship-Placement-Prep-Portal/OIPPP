{
  "name": "oippp-server",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "seed": "node scripts/seed-admin.js",
    "seed:demo": "node scripts/seed-demo.js",
    "lint": "eslint src tests scripts",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:api": "npx --yes newman@6.2.3 run ../docs/testing/OIPPP.postman_collection.json -e ../docs/testing/OIPPP.local.postman_environment.json --working-dir ../docs/testing",
    "test:load": "node scripts/load-test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.1",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 70
      }
    }
  }
}
