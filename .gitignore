# ---------------------------------------------------------------
# PDFs
# Only submitted deliverables (Deliverables_Part-1/, Part-2/, ...)
# are committed. Course templates, guidelines and local copies
# anywhere else stay untracked.
# ---------------------------------------------------------------
*.pdf
!Deliverables_*/*.pdf

# course templates and superseded drafts, kept locally only
docs/new/
docs/old/

# ---------------------------------------------------------------
# Node / MERN
# ---------------------------------------------------------------
node_modules/
dist/
build/
.cache/
coverage/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------
# Python (analytics / aptitude-scoring service)
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
venv/
.venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
